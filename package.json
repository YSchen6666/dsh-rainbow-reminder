{
  "name": "@local/dsh-rainbow-reminder",
  "version": "3.2.0",
  "type": "module",
  "description": "DSH 桌面提醒 — 任务等待/错误/完成时在屏幕顶部点亮三色光带，四周同步极光能量场，DSH 在后台也提醒",
  "engines": {
    "dsh": ">= 0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-plugin-manager": "*"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "trust.js",
    "cordis.patch.yml",
    "desktop/reminder.ps1",
    "desktop/config.json",
    "desktop/fix-bom.ps1",
    "desktop/start.ps1",
    "desktop/stop.ps1",
    "desktop/autostart.ps1",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
